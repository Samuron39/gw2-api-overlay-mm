{
  "name": "gw2-inventory-overlay",
  "version": "0.4.13",
  "description": "Modulær Guild Wars 2-overlay: inventory-rådgiver med lokal AI, tidsplan, dagens gjøremål, Trading Post, DPS fra ArcDPS-logger, karakterer og guild",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.js",
    "predist": "npm run build:native",
    "dist": "electron-builder --win --dir",
    "predist:installer": "npm run build:native",
    "dist:installer": "electron-builder --win nsis",
    "prerelease": "npm run build:native",
    "release": "electron-builder --win nsis --publish always",
    "check": "node scripts/check-syntax.js",
    "build:native": "node scripts/build-native.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "no.magna.gw2overlay",
    "productName": "GW2 Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "helper/target/release/gw2overlay_helper.exe",
        "to": "helper/gw2overlay_helper.exe"
      },
      {
        "from": "bridge/target/release/gw2overlay_bridge.dll",
        "to": "bridge/gw2overlay_bridge.dll"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "shortcutName": "GW2 Overlay",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Samuron39",
        "repo": "gw2-api-overlay-mm"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
